# Copy these values into your shell environment before running the app.
# PowerShell example:
#   $env:DASHSCOPE_API_KEY="sk-..."
#   $env:DEEPSEEK_API_KEY="sk-..."

DASHSCOPE_API_KEY=your-dashscope-api-key-here
DASHSCOPE_MODEL=qwen-max
DEEPSEEK_API_KEY=your-deepseek-api-key-here
SERVER_PORT=8080

# Optional local database settings
AIFLOW_DATASOURCE_URL=jdbc:h2:file:./data/aiflow;AUTO_SERVER=TRUE
AIFLOW_DATASOURCE_USERNAME=sa
AIFLOW_DATASOURCE_PASSWORD=
