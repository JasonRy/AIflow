# Copy these values into your shell environment before running the app.
# PowerShell example:
#   $env:DASHSCOPE_API_KEY="sk-..."
#   $env:DEEPSEEK_API_KEY="sk-..."

DASHSCOPE_API_KEY=your-dashscope-api-key-here
DASHSCOPE_MODEL=qwen-max
DEEPSEEK_API_KEY=your-deepseek-api-key-here
SERVER_PORT=8080

# Docker PostgreSQL settings
AIFLOW_POSTGRES_DB=aiflow
AIFLOW_POSTGRES_USER=aiflow
AIFLOW_POSTGRES_PASSWORD=aiflow_dev_password
AIFLOW_POSTGRES_PORT=5432

# Spring datasource settings
AIFLOW_DATASOURCE_URL=jdbc:postgresql://localhost:5432/aiflow
AIFLOW_DATASOURCE_DRIVER=org.postgresql.Driver
AIFLOW_DATASOURCE_USERNAME=aiflow
AIFLOW_DATASOURCE_PASSWORD=aiflow_dev_password
